# OpenAI API key used for the Responses API
OPENAI_API_KEY=sk-...
# Optional override of the model name (defaults to gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini
# Hosted GitHub MCP server URL
GITHUB_MCP_URL=https://mcp.example.com
# Fine-grained GitHub PAT with Metadata(read), Contents(read&write), Pull requests(read&write)
GITHUB_MCP_PAT=ghp_...
# Default CLI flags for local development
REPO_TIDY_ASSUME_YES=false
REPO_TIDY_DRY_RUN=true
