# .env.example
#
# Copy this file to `.env` and fill in values.
# NEVER commit your real secrets to git.

# --- OpenAI ---
OPENAI_API_KEY=sk-REPLACE_ME
# Choose a reasoning-capable model available to your account.
OPENAI_MODEL=gpt-5-reasoning

# --- GitHub MCP (Hosted or Local) ---
# Set the MCP endpoint URL.
# Example (hosted; see the GitHub MCP listing for the canonical URL):
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# Example (enterprise; consult your enterprise docs):
# GITHUB_MCP_URL=https://copilot.your-enterprise-domain/mcp/
# Example (local MCP server behind a reverse proxy):
# GITHUB_MCP_URL=http://localhost:8765/mcp/
GITHUB_MCP_URL=REPLACE_ME

# Fine-grained Personal Access Token (PAT) with minimum permissions:
# - Repository access: Only selected repositories
# - Repository permissions:
#     Metadata → Read-only
#     Contents → Read & Write  (needed to delete branches)
#     Pull requests → Read & Write (needed to close PRs)
# DO NOT grant `delete_repo` — that deletes entire repositories and is not needed.
GITHUB_MCP_PAT=ghp_REPLACE_ME

# --- Repo Tidy defaults ---
REPO_TIDY_ASSUME_YES=false
REPO_TIDY_DRY_RUN=false

# Optional: logging level (info|debug)
LOG_LEVEL=info
